    {
      "dot": "emerald",
      "title": "Query Condensation & Adaptive Routing",
      "items": [
        "Resolves multi-turn conversational coreference ('What did it cost?')",
        "Sub-second LPU rewrite generates standalone search terms before SQL execution",
        "Conversational chit-chat bypasses vector retrieval entirely to save latency"
      ]
    },
    {
      "dot": "rose",
      "title": "Corrective RAG (CRAG) Fallback",
      "items": [
        "decide_after_retrieval evaluates candidate presence and quality score",
