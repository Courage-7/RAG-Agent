RAG_ENVIRONMENT=local
RAG_LOG_LEVEL=INFO
RAG_JSON_LOGS=false

GROQ_API_KEY=
RAG_GROQ_FAST_MODEL=llama-3.1-8b-instant
RAG_GROQ_QUALITY_MODEL=llama-3.3-70b-versatile
RAG_GROQ_AGENT_MODEL=llama-3.3-70b-versatile

RAG_REDIS_BROKER_URL=redis://127.0.0.1:6379/0
RAG_DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres
RAG_SUPABASE_URL=http://127.0.0.1:54321
RAG_SUPABASE_PUBLISHABLE_KEY=

